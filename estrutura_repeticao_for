texto = input("Informe um texto: ")
VOGAIS = "AEIOU"

if texto:  # garante que não está vazio
    print(f"As vogais em '{texto}' são: ", end="")

    for x in texto:
        if x.upper() in VOGAIS:
            print(x, end="")

    print()  # quebra de linha no final
else:
    print("Digite um texto válido!")
print("Fim do programa.")
print("")


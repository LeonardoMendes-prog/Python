opcao = -1

print("Escolha uma opção: \n")
while opcao != 0:
    print("Escolha uma opção: \n")
    opcao = int(input("[1] Sacar \n[2] Extrato \n[0] Sair \n"))
    print(f"Você escolheu a opção {opcao}.")
    print("Processando...")
    print("Aguarde...")
    print("Processamento concluído.")
    print("--------------------------------------------------")
    
    
    if opcao == 1:
        print("Sacando...")
        print("--------------------------------------------------")
    elif opcao == 2:
        print("Exibindo o extrato...")
        print("--------------------------------------------------")
else:
    print("Saindo do sistema...")
